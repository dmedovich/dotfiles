font-family = Mononoki Nerd Font
font-size = 13

theme = Brogrammer
#0x96f
#Oxocarbon
#Ghostty Default Style Dark 
#Kanagawa Wave 
#Brogrammer 
#Monokai Pro Machine

cursor-style = block
shell-integration = zsh

window-padding-x = 8
window-padding-y = 8

confirm-close-surface = true
copy-on-select = true

keybind = ctrl+shift+left=goto_split:left
keybind = ctrl+shift+right=goto_split:right
keybind = ctrl+shift+up=goto_split:up
keybind = ctrl+shift+down=goto_split:down

# Keep projects in ordinary Ghostty tabs and inherit their working directory.
tab-inherit-working-directory = true
split-inherit-working-directory = true
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+page_up=previous_tab
keybind = ctrl+shift+page_down=next_tab
keybind = ctrl+shift+e=new_split:right
keybind = ctrl+shift+o=new_split:down
keybind = ctrl+shift+enter=toggle_split_zoom
